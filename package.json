{
    "name": "singularity-city",
    "version": "1.0.0",
    "private": true,
    "description": "A pixel-art AI industry city simulation. Dev tooling only — the app itself is a zero-bundler browser project.",
    "type": "module",
    "scripts": {
        "lint": "eslint \"js/**/*.js\"",
        "lint:fix": "eslint \"js/**/*.js\" --fix",
        "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\" \"*.json\" \"*.md\"",
        "format:check": "prettier --check \"js/**/*.js\"",
        "check": "npm run lint && npm run format:check",
        "cachebust": "node tools/cachebust.mjs",
        "serve": "python serve.py 8931",
        "test:fp": "npm run test:fp:imports && npm run test:fp:parity && npm run test:fp:schedule && npm run test:fp:interiors && npm run test:fp:streets && npm run test:fp:store",
        "test:fp:schedule": "node first-person/tests/schedule_parity_check.mjs",
        "test:fp:imports": "node first-person/tests/run_node_check.mjs",
        "test:fp:parity": "node --import ./first-person/tests/hooks/three_resolver.mjs first-person/tests/parity_exercise.mjs",
        "test:fp:interiors": "node --import ./first-person/tests/hooks/three_resolver.mjs first-person/tests/interior_theme_check.mjs",
        "test:fp:streets": "node first-person/tests/street_check.mjs",
        "test:fp:store": "node first-person/tests/store_check.mjs"
    },
    "devDependencies": {
        "esbuild": "^0.28.0",
        "eslint": "^9.17.0",
        "prettier": "^3.4.2",
        "serve": "^14.2.6"
    }
}
