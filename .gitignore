__pycache__/
# ...except the local playtest server. python -m http.server is single-threaded,
# so a keep-alive connection from one tab hangs every other request; this one is
# threaded and adds the dev-only /__shot endpoint First Person uses to capture
# WebGL frames without a browser pane.
!serve.py

# Dev-only screenshot drop written by serve.py POST /__shot
.shots/

# Logs
*.log

# Environment / secrets
.env
.env.local

# Throwaway Chrome user-data-dir written by first-person/tests/find_nan_geo.mjs.
# It is a full browser profile — ~600 files of caches, cookies and LevelDB —
# and `git add -A first-person` swallows the lot.
first-person/tests/chrome-nan-profile/
